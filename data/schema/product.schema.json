{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomos.dev/schema/product.schema.json",
  "title": "Product",
  "type": "object",
  "required": ["id", "vendor_id", "name", "type", "tags", "aliases"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "vendor_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "type": { "enum": ["hardware", "appliance", "firmware", "os", "software", "library"] },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "icon": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[a-z0-9]+(-[a-z0-9]+)*$" },
    "domain": {
      "type": "string",
      "maxLength": 253,
      "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+(?:[a-z]{2,63}|xn--[a-z0-9-]{1,59})$",
      "not": { "pattern": "\\n" }
    },
    "cpe": {
      "type": "string",
      "pattern": "^cpe:2\\.3:[aoh]:(?:[^:\\\\]|\\\\.)+:(?:[^:\\\\]|\\\\.)+:\\*(:\\*){7}$"
    },
    "purl": {
      "type": "string",
      "pattern": "^pkg:[a-z][a-z0-9.+-]*\\/.+$"
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/license" }
    },
    "aliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/alias" }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["protocol", "port", "name"],
        "additionalProperties": false,
        "properties": {
          "protocol": { "enum": ["tcp", "udp"] },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "name": { "type": "string", "minLength": 1 },
          "default": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "license": {
      "type": "object",
      "required": ["spdx", "evidence"],
      "additionalProperties": false,
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "versions": { "type": "string", "pattern": "^vers:generic/\\S+$", "not": { "pattern": "\\n" } },
        "evidence": { "type": "string", "pattern": "^https://[^\\s/?#]+\\S*$", "not": { "pattern": "\\n" } },
        "confidence": { "enum": ["curated", "auto"], "default": "curated" }
      }
    },
    "alias": {
      "type": "object",
      "required": ["source", "value", "confidence"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["nvd", "cisa_kev", "osv", "endoflife", "banner", "name"] },
        "value": { "type": "string", "minLength": 1 },
        "ecosystem": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["curated", "auto"] }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "banner" } }, "required": ["source"] },
          "then": {
            "properties": {
              "value": {
                "pattern": "^[a-z0-9*][a-z0-9._+/*-]*(?: [a-z0-9._+/*-]+)*$",
                "not": { "pattern": "[/_ ][0-9]|\\n" }
              }
            }
          }
        },
        {
          "if": { "properties": { "source": { "const": "name" } }, "required": ["source"] },
          "then": {
            "properties": { "value": { "pattern": "^\\S+(?: \\S+)*$", "not": { "pattern": "\\n" } } }
          }
        }
      ]
    }
  }
}
